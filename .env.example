# Copiá este archivo como .env.local y completá los valores.
# En Vercel, las mismas variables van en Settings -> Environment Variables.

# ---------------------------------------------------------------------------
# Base de datos (Neon)
#
# Son DOS strings del MISMO branch y no son intercambiables:
#
#   DATABASE_URL  -> el POOLED, el host termina en "-pooler". Lo usa la app en
#                    runtime. Prisma en serverless abre una conexión por
#                    invocación: sin el pooler, Neon corta por límite de
#                    conexiones apenas hay algo de tráfico.
#   DIRECT_URL    -> el DIRECTO, sin "-pooler". Lo usa solo la CLI de Prisma
#                    (db pull, migrate, seed), que necesita una sesión estable.
#
# Sin esta separación anda en local y se rompe en Vercel.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:password@ep-xxx-pooler.region.aws.neon.tech/rutinas?sslmode=require"
DIRECT_URL="postgresql://usuario:password@ep-xxx.region.aws.neon.tech/rutinas?sslmode=require"

# ---------------------------------------------------------------------------
# Clerk
#
# Las claves de desarrollo (pk_test_ / sk_test_) y las de producción
# (pk_live_ / sk_live_) son de instancias distintas: los usuarios NO se comparten
# entre ellas. Al pasar a producción hay que volver a dar de alta al profesor y
# reinvitar a los alumnos, o migrarlos desde el dashboard de Clerk.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Dónde viven las pantallas de auth y adónde caer después del login.
# /post-login lee el rol en la tabla `usuarios` y manda a /dashboard o a /hoy;
# no lo cambies por una ruta fija o el alumno va a terminar en el panel del
# profesor y al revés.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/post-login"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/post-login"
